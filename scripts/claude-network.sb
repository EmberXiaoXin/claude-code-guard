(version 1)

; Direct IP / DNS / non-loopback TCP+UDP is denied.
; Remote traffic must use the unsandboxed gate on localhost:7899.
; Loopback is allowed so httptest, docker-mapped ports and local preview work.
; Unix sockets stay denied so the process cannot switch the Clash exit.
(allow default)
(deny network-outbound)
(allow network-outbound (remote ip "localhost:*"))
